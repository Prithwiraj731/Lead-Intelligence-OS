# LEAD INTELLIGENCE OS - Environment Configuration Template
# Copy this file to .env and configure your environment

# PostgreSQL Connection (Docker container: leadintel-postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/leadintel_db?schema=public"

# n8n Orchestration Layer (Optional - local inspector fallback is active if n8n is offline)
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_SECRET="b52dd18759ad3593ed6b2cb3e77cb073ef3a55af67a302e52e6a9e5ce1160562"
N8N_API_KEY=""

# AI Provider Configuration
# Options: rule-engine (default, offline, zero API keys needed) | openai | gemini | anthropic
AI_PROVIDER="rule-engine"
AI_MODEL="gemini-2.0-flash"

# Optional LLM API Keys (Only needed if AI_PROVIDER is not "rule-engine")
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Outbound Delivery Configuration
# For production sending: set OUTBOUND_DELIVERY_ENABLED=true and OUTBOUND_DRY_RUN=false
OUTBOUND_DELIVERY_ENABLED=false
OUTBOUND_DRY_RUN=true

# Gmail OAuth 2.0 (Optional - for controlled Gmail pilot delivery)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"

# SMTP Delivery (Optional fallback)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Resend Provider (Optional)
RESEND_API_KEY=""

# WhatsApp Cloud API (Optional - currently disabled by safety gate in pilot mode)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Server Configuration
PORT=3000
NODE_ENV="development"
